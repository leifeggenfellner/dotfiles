// Rice boot splash (D-044). Generated per theme by _plymouth-theme.nix:
// Placeholders are replaced with theme colours (as "r, g, b" floats) and copy.
// A sigil fades in through drifting fog, an ink ring fills with boot
// progress (and drains while the machine shuts down or reboots), and
// passphrase/question prompts are drawn under the sigil.

Window.SetBackgroundTopColor(@bgTop@);
Window.SetBackgroundBottomColor(@bgBottom@);

font = "@font@";
ring_frames = @ringFrames@;

sigil_raw = Image("sigil.png");
glow_raw = Image("glow.png");
fog_raw = Image("fog.png");
bullet_raw = Image("bullet.png");
for (i = 0; i < ring_frames; i++)
  ring_raw[i] = Image("ring-" + i + ".png");
for (i = 0; i < ring_frames - 1; i++)
  seep_raw[i] = Image("seep-" + i + ".png");

glow = Sprite();
sigil = Sprite();
ring = Sprite();
seep = Sprite();
fog_low = Sprite();
fog_high = Sprite();
// Hidden until the refresh callback fades them in.
glow.SetOpacity(0);
sigil.SetOpacity(0);
ring.SetOpacity(0);
seep.SetOpacity(0);
fog_low.SetOpacity(0);
fog_high.SetOpacity(0);

// Scale and place everything for the current window size. It runs again
// whenever the size changes: when the real GPU driver replaces the
// firmware framebuffer mid-splash, the canvas changes under the script.
fun layout() {
  global.W = Window.GetWidth();
  global.H = Window.GetHeight();
  global.unit = Math.Min(W, H);

  // Sigil and its glow share one padded canvas, so they scale together.
  global.sigil_size = Math.Int(unit * 0.34);
  global.sigil_x = Math.Int(W / 2 - sigil_size / 2);
  global.sigil_y = Math.Int(H * 0.44 - sigil_size / 2);
  glow.SetImage(glow_raw.Scale(sigil_size, sigil_size));
  glow.SetPosition(sigil_x, sigil_y, 9);
  sigil.SetImage(sigil_raw.Scale(sigil_size, sigil_size));
  sigil.SetPosition(sigil_x, sigil_y, 10);

  // Ink ring: pre-rendered frames, centred on the sigil. Between frames
  // the next segment (seep-i: ink from frame i to i + 1, no track) fades
  // in over the current frame, so the ink seeps instead of stepping.
  ring_size = Math.Int(sigil_size * 1.08);
  for (i = 0; i < ring_frames; i++)
    global.ring_image[i] = ring_raw[i].Scale(ring_size, ring_size);
  for (i = 0; i < ring_frames - 1; i++)
    global.seep_image[i] = seep_raw[i].Scale(ring_size, ring_size);
  ring_x = Math.Int(W / 2 - ring_size / 2);
  ring_y = Math.Int(sigil_y + sigil_size / 2 - ring_size / 2);
  ring.SetImage(ring_image[frame]);
  ring.SetPosition(ring_x, ring_y, 8);
  seep.SetImage(seep_image[frame]);
  seep.SetPosition(ring_x, ring_y, 8);

  // Two fog banks drifting against each other along the floor. Every move
  // repaints most of the screen in software, so they step together on
  // every fog_step-th tick rather than on alternating ticks.
  fog_image = fog_raw.Scale(Math.Int(W * 1.6), Math.Int(H * 0.55));
  fog_low.SetImage(fog_image);
  fog_low.SetY(Math.Int(H * 0.45));
  fog_low.SetZ(5);
  fog_high.SetImage(fog_image);
  fog_high.SetY(Math.Int(H * 0.32));
  fog_high.SetZ(4);

  global.prompt_y = Math.Int(sigil_y + sigil_size + unit * 0.06);
  global.bullet_size = Math.Max(Math.Int(unit * 0.014), 8);
  global.bullet_image = bullet_raw.Scale(bullet_size, bullet_size);
}

global.tick = 0;
global.progress = 0;
global.target = 0;
global.shown = 0;
global.frame = 0;
global.prompting = 0;
global.now = 0;
global.last = 0;
fog_step = 4;

// Shutdown and reboot report no progress, so the ink drains on the
// script's own clock instead; it never empties, so a slow stop job
// still reads as work in progress rather than a frozen screen.
mode = Plymouth.GetMode();
global.draining = (mode == "shutdown" || mode == "reboot");
if (draining) {
  global.shown = 1;
  global.frame = ring_frames - 2;
}
layout();

fun refresh_callback() {
  global.tick = tick + 1;
  if (Window.GetWidth() != W || Window.GetHeight() != H)
    layout();
  fade = Math.Min(tick / 120, 1);
  breath = Math.Sin(tick / 45);

  // Plymouth skips opacity changes under 0.01, so these rarely repaint.
  sigil.SetOpacity(fade * (0.88 + 0.12 * breath) * (1 - 0.45 * prompting));
  glow.SetOpacity(fade * (0.45 + 0.25 * breath));
  if (tick % fog_step == 0 || tick <= 120) {
    fog_low.SetX(Math.Int(-W * 0.3 + Math.Sin(tick / 1400) * W * 0.22));
    fog_low.SetOpacity(fade * 0.55);
    fog_high.SetX(Math.Int(-W * 0.3 - Math.Sin(tick / 1800 + 1.3) * W * 0.18));
    fog_high.SetOpacity(fade * 0.28);
  }

  // Progress is a time estimate from the last boot, which includes the
  // passphrase wait, so it leaps to nearly full on unlock and only a few
  // seconds of boot remain; hold the ink while the Threshold asks.
  if (!prompting)
    global.target = progress;
  // Seep toward the target by wall-clock time, not ticks: software
  // repaints of the fog stretch ticks well past the nominal refresh rate.
  // Capped at 0.6 ring/s with an eased tail, a full ring takes ~2 s and
  // closes before the splash quits.
  dt = Math.Clamp(now - last, 0, 0.25);
  global.last = now;
  if (draining)
    global.shown = 1 / (1 + tick / 900);
  else
    global.shown = shown + Math.Clamp((target - shown) * 4 * dt, 0, 0.6 * dt);
  position = Math.Clamp(shown, 0, 1) * (ring_frames - 1);
  current = Math.Min(Math.Int(position), ring_frames - 2);
  if (current != frame) {
    global.frame = current;
    ring.SetImage(ring_image[current]);
    seep.SetImage(seep_image[current]);
  }
  ring.SetOpacity(fade * 0.9);
  seep.SetOpacity(fade * 0.9 * (position - current));
}
Plymouth.SetRefreshFunction(refresh_callback);

// `duration` is seconds since the splash started: the script's clock.
fun boot_progress_callback(duration, value) {
  global.now = duration;
  if (value > progress)
    global.progress = value;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

// ── Prompts ─────────────────────────────────────────────────
// The theme's label sits above the real prompt text, never instead of it.
// prompt_y and the bullet image come from layout().
label_sprite = Sprite();
prompt_sprite = Sprite();
entry_sprite = Sprite();
max_bullets = 32;

fun place_centered(sprite, image, y) {
  sprite.SetImage(image);
  sprite.SetPosition(Math.Int(W / 2 - image.GetWidth() / 2), y, 20);
  sprite.SetOpacity(1);
}

fun show_prompt(prompt) {
  global.prompting = 1;
  label = Image.Text("@promptLabel@", @labelColor@, 1, font + " 16");
  place_centered(label_sprite, label, prompt_y);
  text = Image.Text(prompt, @textColor@, 1, font + " 13");
  place_centered(prompt_sprite, text, Math.Int(prompt_y + label.GetHeight() + unit * 0.012));
  return Math.Int(prompt_y + label.GetHeight() + text.GetHeight() + unit * 0.035);
}

fun hide_bullets() {
  for (i = 0; i < max_bullets; i++)
    if (bullet_sprite[i])
      bullet_sprite[i].SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
  y = show_prompt(prompt);
  entry_sprite.SetOpacity(0);
  count = Math.Min(bullets, max_bullets);
  gap = Math.Int(bullet_size * 0.7);
  row = count * bullet_size + Math.Max(count - 1, 0) * gap;
  for (i = 0; i < max_bullets; i++) {
    // Function-level assignments are local in Plymouth script.
    if (!bullet_sprite[i])
      global.bullet_sprite[i] = Sprite();
    // Set on every call: layout() rescales the image if the display changes.
    bullet_sprite[i].SetImage(bullet_image);
    if (i < count) {
      bullet_sprite[i].SetPosition(Math.Int(W / 2 - row / 2 + i * (bullet_size + gap)), y, 20);
      bullet_sprite[i].SetOpacity(1);
    } else {
      bullet_sprite[i].SetOpacity(0);
    }
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(prompt, entry) {
  y = show_prompt(prompt);
  hide_bullets();
  place_centered(entry_sprite, Image.Text(entry + "_", @textColor@, 1, font + " 13"), y);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
  global.prompting = 0;
  label_sprite.SetOpacity(0);
  prompt_sprite.SetOpacity(0);
  entry_sprite.SetOpacity(0);
  hide_bullets();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ── Messages (fsck, systemd notices) ────────────────────────
message_sprite = Sprite();

fun message_callback(text) {
  image = Image.Text(text, @mutedColor@, 1, font + " 11");
  message_sprite.SetImage(image);
  message_sprite.SetPosition(Math.Int(W / 2 - image.GetWidth() / 2), Math.Int(H * 0.92), 20);
  message_sprite.SetOpacity(1);
}
Plymouth.SetMessageFunction(message_callback);

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}
Plymouth.SetHideMessageFunction(hide_message_callback);
