# HyprFM colours from the active theme (D-055). Writes
# $XDG_CONFIG_HOME/hyprfm/themes/rice.toml, which HyprFM watches and
# reloads live; the rice-hyprfm module points config.toml at it. Does
# nothing where HyprFM has no config directory (not installed or never
# set up), so rice-switch can call it on every host.
{ pkgs }:
let
  activeManifestLib = import ./_active-manifest-lib.nix { inherit pkgs; };
  dailyLib = import ./_daily-lib.nix;

  # Adwaita's folder-shaped places icons, recoloured at run time. They
  # share one set of blues; trash, network and server icons keep theirs.
  folders = pkgs.runCommand "rice-hyprfm-folders" { } ''
    mkdir -p "$out"
    cp ${pkgs.adwaita-icon-theme}/share/icons/Adwaita/scalable/places/{folder,folder-*,user-home,user-desktop,user-bookmarks}.svg "$out"/
  '';
in
pkgs.writeShellScriptBin "rice-hyprfm-theme" ''
  set -euo pipefail

  jq="''${RICE_JQ:-${pkgs.jq}/bin/jq}"
  index="''${RICE_INDEX:-$HOME/.config/rice/themes.json}"
  state_dir="''${XDG_STATE_HOME:-$HOME/.local/state}/rice"
  pointer="$state_dir/active"
  prefs="$state_dir/prefs.json"
  config_dir="''${XDG_CONFIG_HOME:-$HOME/.config}/hyprfm"
  # Where HyprFM's icon watcher looks (it does not read XDG_DATA_HOME).
  icon_dir="$HOME/.local/share/icons/rice"
  manifest=""
  print=0

  fail() {
    echo "rice-hyprfm-theme: $*" >&2
    exit 1
  }

  ${activeManifestLib}

  usage() {
    echo "Usage: rice-hyprfm-theme [--print] (--active | --manifest <path>)"
  }

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --print)
        print=1; shift ;;
      --active)
        [ -z "$manifest" ] || fail "choose exactly one manifest source"
        rice_resolve_active
        shift ;;
      --manifest)
        [ "$#" -ge 2 ] || fail "--manifest requires a path"
        [ -z "$manifest" ] || fail "choose exactly one manifest source"
        manifest="$2"; shift 2 ;;
      -h|--help)
        usage; exit 0 ;;
      *)
        fail "unknown argument: $1" ;;
    esac
  done

  [ -n "$manifest" ] || { usage >&2; exit 64; }
  manifest="$(canonical_store_file "theme manifest" "$manifest")"
  [ "$print" = 1 ] || [ -d "$config_dir" ] || exit 0

  # Daily accent (D-054), resolved as rice-hyprland-theme does:
  # RICE_DAILY_ACCENT=#rrggbb|none overrides the record in prefs.json.
  daily="''${RICE_DAILY_ACCENT:-}"
  prefs_source=/dev/null
  [ ! -r "$prefs" ] || prefs_source="$prefs"

  # Token roles onto HyprFM's colour keys. The 16-colour terminal palette
  # comes from palette.legacy, laid out like the console palette (D-044)
  # but with a surface for black; brights lighten their normal colour.
  # Folder icons take the accent by role: Adwaita's pale front becomes it
  # (pale reads washed out on a dark theme), the rim and back darken it,
  # and the glints mix it toward white.
  mapped="$("$jq" -ec --arg daily "$daily" --arg today "$(${pkgs.coreutils}/bin/date +%F)" \
    --rawfile prefs_raw "$prefs_source" '
    ${dailyLib}
    def color: type == "string" and test("^#[0-9a-fA-F]{6}$");
    def byte: ascii_downcase | explode | map(if . >= 97 then . - 87 else . - 48 end) | .[0] * 16 + .[1];
    def hex2: [(. / 16 | floor), (. % 16)] | map("0123456789abcdef"[.:. + 1]) | join("");
    def channels(f): ltrimstr("#") as $h | "#" + ([0, 2, 4] | map($h[.:. + 2] | byte | f | floor | hex2) | join(""));
    def lighten($p): channels(. + (255 - .) * $p / 100);
    def darken($p): channels(. * (100 - $p) / 100);
    (if $daily == "none" then . elif $daily != "" then .tokens.colors.accent.primary = $daily
     elif .widgets.dailyAccent == null then . else with_daily_accent(try ($prefs_raw | fromjson) catch {}; $today) end) |
    .tokens.colors as $c |
    [
      ["base", $c.bg.base], ["mantle", $c.bg.mantle // $c.bg.base], ["crust", $c.bg.sunken],
      ["surface", $c.bg.surface1], ["overlay", $c.bg.surface2],
      ["text", $c.fg.primary], ["subtext", $c.fg.muted], ["muted", $c.fg.subtle],
      ["accent", $c.accent.primary],
      ["success", $c.state.ok], ["warning", $c.state.warn], ["error", $c.state.danger]
    ] as $roles |
    if ($roles | map(.[1] | color) | all | not) then error("theme colour tokens are not all #rrggbb") else . end |
    ((.palette.legacy // {}) | map_values("#" + .)) as $l |
    ([$l.red, $l.green, $l.yellow, $l.blue, $l.mauve, $l.teal]) as $normal |
    ([$l.surface1, $l.subtext1, $l.surface2, $l.text] + $normal) as $needed |
    $c.accent.primary as $a |
    { folders: { "#a4caee": $a, "#62a0ea": ($a | darken(12)), "#438de6": ($a | darken(28)),
                 "#afd4ff": ($a | lighten(30)), "#c0d5ea": ($a | lighten(30)) },
      toml: ("# Generated by rice-hyprfm-theme from the active rice theme.\n[colors]\n"
    + ($roles | map("\(.[0]) = \"\(.[1])\"\n") | join(""))
    + (if ($needed | map(color) | all) then
        ([$l.surface1] + $normal + [$l.subtext1, $l.surface2] + ($normal | map(lighten(30))) + [$l.text]) as $p |
        "\n[terminal]\npalette = [\n" + ($p | map("    \"\(.)\",\n") | join("")) + "]\n"
      else "" end)) }
  ' "$manifest")" || fail "could not map theme colours from $manifest"
  toml="$("$jq" -r .toml <<< "$mapped")"

  if [ "$print" = 1 ]; then
    printf '%s' "$toml"
    exit 0
  fi

  ${pkgs.coreutils}/bin/mkdir -p -- "$config_dir/themes"
  tmp="$(${pkgs.coreutils}/bin/mktemp --tmpdir="$config_dir/themes" .rice.XXXXXX)"
  printf '%s' "$toml" > "$tmp"
  ${pkgs.coreutils}/bin/mv -fT -- "$tmp" "$config_dir/themes/rice.toml"

  # The "rice" icon theme: recoloured folders over Adwaita. Each file is
  # replaced atomically; HyprFM's auto_refresh_icons picks them up.
  ${pkgs.coreutils}/bin/mkdir -p -- "$icon_dir/scalable/places"
  if [ ! -e "$icon_dir/index.theme" ]; then
    printf '%s\n' '[Icon Theme]' 'Name=rice' 'Comment=Rice folders over Adwaita' 'Inherits=Adwaita,hicolor' \
      'Directories=scalable/places' "" '[scalable/places]' 'Size=128' 'MinSize=8' 'MaxSize=512' \
      'Type=Scalable' 'Context=Places' > "$icon_dir/index.theme"
  fi
  script="$("$jq" -r '.folders | to_entries | map("s/\(.key)/\(.value)/gI") | join(";")' <<< "$mapped")"
  for svg in ${folders}/*.svg; do
    tmp="$(${pkgs.coreutils}/bin/mktemp --tmpdir="$icon_dir/scalable/places" .rice.XXXXXX)"
    ${pkgs.gnused}/bin/sed -e "$script" "$svg" > "$tmp"
    ${pkgs.coreutils}/bin/chmod 644 "$tmp"
    ${pkgs.coreutils}/bin/mv -fT -- "$tmp" "$icon_dir/scalable/places/''${svg##*/}"
  done
''
