# Baseline group-bar chrome (Hyprland's own defaults, made explicit).
# Imported by _settings.nix (the generated config) and by the rice
# Hyprland adapter, which re-applies it before a theme's chrome so
# switching to a theme without one restores it exactly (D-049).
{
  groupbar = {
    col = {
      active = "rgba(ffff0066)";
      inactive = "rgba(77770066)";
    };
    text_color = "rgb(ffffff)";
    text_color_inactive = "rgb(ffffff)";
    font_family = "";
  };
}
