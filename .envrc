#!/usr/bin/env bash
# -*- mode: shell-script -*-

# Delegates to nix-direnv's use_flake (see modules/programs/direnv.nix), which
# restores TMPDIR/TMP/TEMP/NIX_BUILD_TOP after loading the cached profile.
# `nix print-dev-env` points TMPDIR at a throwaway /tmp/nix-shell.XXXXXX dir
# that can be garbage-collected later; without this restore, anything that
# relies on $TMPDIR (e.g. fish's psub) breaks with a stale-directory mktemp
# error once that dir disappears. A hand-rolled use_flake here would shadow
# nix-direnv's fix, so don't redefine it — just call `use flake`.
use flake . --option builders ""
